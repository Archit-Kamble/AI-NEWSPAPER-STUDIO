# SAHAS — configuration.
#
# Copy this file to `.env` and fill it in. `.env` is gitignored and must never
# be committed: it holds the database password and the AI provider keys.

PORT=3000
SESSION_SECRET=change-this-secret

# --- Database ---------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sahas
DB_USER=postgres
DB_PASSWORD=

# --- AI providers -----------------------------------------------------------
#
# SAHAS is provider-agnostic: the application asks for a tier of effort, and
# whichever provider is configured serves it. See docs/AI.md.
#
# Which provider writes the copy that gets printed. Sarvam is the default
# because it is built for Indian languages - its tokenizer treats a Marathi word
# as a word rather than four fragments, and its Marathi reads like a person
# wrote it rather than like a translation.
AI_PROVIDER=sarvam

# The provider used when the first one errors or times out. A newspaper goes to
# press whether or not an API is having a bad night. Leave empty for none.
AI_FALLBACK_PROVIDER=gemini

# Sarvam — https://dashboard.sarvam.ai
SARVAM_API_KEY=
# Only one chat model exists (sarvam-30b and sarvam-m are deprecated).
SARVAM_MODEL=sarvam-105b
# Your Sarvam plan caps how much the model may generate, and reasoning tokens
# count against it: Starter 4096, Pro 16384, Business 128000. If the Ultra tier
# ever returns nothing, this is why - the reasoning consumed the whole budget.
SARVAM_MAX_OUTPUT_TOKENS=4096

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI — optional, OpenAI-compatible.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic — optional.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# How long to wait for a model before giving up, in milliseconds.
AI_TIMEOUT_MS=60000
