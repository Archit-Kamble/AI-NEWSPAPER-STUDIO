# SAHAS — configuration.
#
# Copy this file to `.env` and fill it in. `.env` is gitignored and must never
# be committed: it holds the database password and the AI provider keys.

PORT=3000
SESSION_SECRET=change-this-secret

# --- Database ---------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sahas
DB_USER=postgres
DB_PASSWORD=

# --- AI providers -----------------------------------------------------------
#
# SAHAS is provider-agnostic: the application asks for a tier of effort, and
# whichever provider is configured serves it. See docs/AI.md.
#
# Which provider writes the copy that gets printed.
#
# Gemini, for room: a full-page lead is long, and what kept reaching the desk
# was a call coming back empty rather than a sentence being a shade off. Leave
# this blank and Gemini is still what writes - it is the built-in default. Put
# `sarvam` here and Sarvam writes instead; nothing in the code is fixed to one
# company, which is the point.
#
# NEVER put an API key in this file. This one is committed to git. Keys live in
# `.env`, which is not.
AI_PROVIDER=gemini

# Who covers when that one errors or times out, in the order they are tried. A
# newspaper goes to press whether or not an API is having a bad night. Comma
# separated; leave empty for none.
AI_FALLBACK_PROVIDER=sarvam,anthropic

# --- 1. Sarvam — the Marathi. https://dashboard.sarvam.ai --------------------
# ₹4 / 1M input · ₹2.5 cached · ₹16 / 1M output. ₹100 free credit on signup,
# which is well over a year of this newspaper.
SARVAM_API_KEY=
# Only one chat model exists (sarvam-30b and sarvam-m are deprecated).
SARVAM_MODEL=sarvam-105b
# Your Sarvam plan caps how much the model may generate, and REASONING TOKENS
# COUNT AGAINST IT.
#
#   Starter    up to   4096
#   Pro        up to  16384   <- the default below
#   Business   up to 128000
#
# The default is 16384 because 4096 is too small to be one: at Plus or Ultra
# effort the reasoning can consume the whole budget and the call returns
# nothing at all - and you are billed for the thinking either way.
#
# max_tokens is a CEILING, not a spend. You pay for the tokens actually
# produced, so raising it costs nothing on calls that finish early. Set it to
# YOUR plan's ceiling - a value above what your account allows is rejected by
# the API. Anything outside 256..128000 is clamped rather than sent.
#
# If a request still cannot finish, SAHAS retries it once at one tier less
# reasoning and twice the room, then tells the desk in plain words. Nobody is
# ever asked to edit this file mid-edition.
SARVAM_MAX_OUTPUT_TOKENS=16384

# --- 2. Google Gemini — the writer. -----------------------------------------
# https://aistudio.google.com/apikey. Gemini 3.6 Flash is $1.50 / 1M input,
# $7.50 / 1M output.
#
# THE FREE TIER WILL NOT RUN THIS NEWSPAPER, and it fails quietly rather than
# loudly. Measured against this project on 10 August 2026:
#
#   generate_content_free_tier_requests, limit: 20 per DAY, per model.
#
# One press of "Write this block" costs TWO requests - the write, and the pass
# that fits the copy to the hole. So the free tier is about ten blocks a day,
# and everything after that silently comes out of the understudy. Enable
# billing on the Google Cloud project before an edition depends on it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Room for the ARTICLE, before any thinking is added on top.
#
# On Gemini, thinking tokens are counted INSIDE maxOutputTokens - measured, not
# assumed: maxOutputTokens 200 with thinkingBudget 4096 came back MAX_TOKENS
# with six tokens of answer. So SAHAS budgets the two separately and adds them:
# the copy gets this many tokens, and the tier's thinking budget goes on top.
# gemini-3.6-flash caps the total at 65536.
GEMINI_MAX_OUTPUT_TOKENS=8192

# --- 3. Anthropic Claude — the second understudy. ---------------------------
# https://console.anthropic.com — Claude Sonnet 5 is $2 / $10 per 1M as an
# introductory rate through 31 August 2026, then $3 / $15 from 1 September.
# Budget for the second pair.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_OUTPUT_TOKENS=4096

# --- Optional: anything speaking the OpenAI shape ---------------------------
# One client for OpenAI, DeepSeek, Krutrim, Together, Groq and most self-hosted
# servers. Set OPENAI_BASE_URL to point it somewhere other than OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# How long to wait for a model before giving up, in milliseconds.
#
# 120s because these are reasoning models: twelve horoscope signs at Basic
# effort measured 40 seconds against a real account, and a lead story at Ultra
# is slower again. At 60s the request was being aborted at this end while the
# model was still writing - which reads as "the AI is broken" and bills for the
# thinking anyway.
AI_TIMEOUT_MS=120000
